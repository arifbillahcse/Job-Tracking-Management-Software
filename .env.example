# Copy to .env and edit. Never commit .env.
APP_ENV=production            # production | local
APP_DEBUG=false               # only honoured when APP_ENV is not production
APP_URL=http://localhost:8000 # include the sub-folder if the app is not at the domain root
TRUST_PROXY=false             # true only behind a reverse proxy / CDN you control

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=job_tracker
DB_USERNAME=job_tracker
DB_PASSWORD=

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
SESSION_SECURE=false          # forced on automatically when the request is HTTPS
REMEMBER_ME_DAYS=14           # "Keep me signed in" on the sign-in page: days a remembered browser stays signed in (0 = no checkbox)

# Copy to .env in the application folder (NOT in public/), then:  chmod 640 .env
# Never commit .env. Values with spaces or # must be in quotes.

APP_ENV=production            # debug output is impossible in production, whatever APP_DEBUG says
APP_DEBUG=false
APP_URL=https://jobs.example.com   # include the sub-folder if the app is not at the domain root
TRUST_PROXY=false             # true ONLY behind a reverse proxy/CDN that overwrites X-Forwarded-* itself

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=job_tracker
DB_USERNAME=job_tracker
DB_PASSWORD="change-me-to-a-long-random-password"

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
SESSION_SECURE=true

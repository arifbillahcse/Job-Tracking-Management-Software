# Nginx server blocks for Job Tracker. Copy to /etc/nginx/sites-available/job-tracker, edit the marked lines,
# symlink into sites-enabled, then:  nginx -t && systemctl reload nginx
# Requires PHP-FPM. The application must be served from the public/ folder only.

server {
    listen 80;
    server_name jobs.example.com;                    # <-- your domain
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name jobs.example.com;                    # <-- your domain
    root /var/www/job-tracker/public;                # <-- where you unpacked the release
    index index.php;

    ssl_certificate     /etc/letsencrypt/live/jobs.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jobs.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    server_tokens off;
    client_max_body_size 8m;                         # imports are limited to 5 MB by the application

    # Everything that is not a real file goes to the front controller.
    location / {
        try_files $uri /index.php$is_args$args;
    }

    # Only index.php may be executed. Any other .php path is a 404, never run.
    location = /index.php {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;  # <-- your PHP-FPM socket
        fastcgi_read_timeout 60s;
    }
    location ~ \.php$ { return 404; }

    # Never serve dotfiles (.env, .git, .htaccess).
    location ~ /\. { deny all; return 404; }

    # Static assets (cache a month; file names carry a ?v= version).
    location ~* \.(css|js|woff2|svg|png|ico)$ {
        expires 30d;
        access_log off;
        try_files $uri =404;
    }

    access_log /var/log/nginx/job-tracker-access.log;
    error_log  /var/log/nginx/job-tracker-error.log;
}
